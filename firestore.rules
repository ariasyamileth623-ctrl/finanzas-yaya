rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'monthlyBudget',
          'hasSetInitialBudget',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'monthlyBudget',
          'hasSetInitialBudget',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid == request.auth.uid && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() <= 320
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (data.monthlyBudget is int || data.monthlyBudget is float)
        && data.monthlyBudget >= 0 && data.monthlyBudget <= 1000000000000
        && data.hasSetInitialBudget is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll([
          'userId',
          'amount',
          'category',
          'date',
          'icon',
          'type',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'amount',
          'category',
          'date',
          'icon',
          'type',
          'description',
          'paymentMethod',
          'observations',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && data.userId == request.auth.uid && data.userId == userId && isValidId(data.userId)
        && (data.amount is int || data.amount is float)
        && data.amount > 0 && data.amount <= 1000000000000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 40
        && data.type is string && (data.type == 'expense' || data.type == 'income')
        && (!('description' in data) || (data.description is string && data.description.size() <= 200))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 60))
        && (!('observations' in data) || (data.observations is string && data.observations.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Complete initial monthly budget onboarding
          (existing().hasSetInitialBudget == false
            && incoming().hasSetInitialBudget == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'hasSetInitialBudget', 'updatedAt']))
          ||
          // Action: Update monthly budget from dashboard
          (incoming().hasSetInitialBudget == existing().hasSetInitialBudget
            && incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'updatedAt']))
          ||
          // Action: Update display name
          (incoming().hasSetInitialBudget == existing().hasSetInitialBudget
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );

      allow delete: if isValidId(userId) && isOwner(userId);

      match /transactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'amount',
            'category',
            'date',
            'icon',
            'type',
            'description',
            'paymentMethod',
            'observations',
            'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
      }
    }
  }
}
